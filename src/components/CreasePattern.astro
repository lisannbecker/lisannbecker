---
// A small origami crease pattern used as a placeholder when a project has no picture.
// The seed makes each project's pattern different but stable between builds.
interface Props {
  seed: number;
}

const { seed } = Astro.props;

let state = seed * 7919;
const random = () => {
  state = (state * 16807) % 2147483647;
  return state / 2147483647;
};
random();
random();

const W = 160;
const H = 100;
const x = Math.round(40 + random() * 80);
const y = Math.round(22 + random() * 56);

const corners = [
  [0, 0],
  [W, 0],
  [0, H],
  [W, H],
];
---

<svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
  {corners.map(([cx, cy]) => <line x1={x} y1={y} x2={cx} y2={cy} />)}
  <line class="valley" x1="0" y1={y} x2={W} y2={y} />
  <line class="mountain" x1={x} y1="0" x2={x} y2={H} />
</svg>

<style>
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  line {
    stroke: color-mix(in oklab, var(--muted) 35%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* Standard origami notation: dashed = valley fold, dash-dot = mountain fold. */
  .valley {
    stroke-dasharray: 6 4;
  }

  .mountain {
    stroke-dasharray: 8 3 1 3;
  }
</style>
