---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/resume';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = `${profile.name}: ${profile.role}, based in Amsterdam.` } = Astro.props;
const fullTitle = title ? `${title} · ${profile.name}` : profile.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ebebeb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <!-- is:inline = leave this script exactly as written, run it before the page paints -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // During a page transition the browser animates the change itself, so skip the fold for
      // anything already on screen. Otherwise the morphing project title would land on a hidden card.
      addEventListener('pagereveal', (event) => {
        if (!event.viewTransition) return;
        document.querySelectorAll('[data-fold]').forEach((el) => {
          if (el.getBoundingClientRect().top < innerHeight) el.classList.add('is-open', 'no-anim');
        });
      });
    </script>
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Unfold [data-fold] elements as they scroll into view, and set the overscroll colour. -->
    <script>
      // Past the middle of the page, overscrolling should reveal black (the footer's colour)
      // instead of paper. See html.near-end in global.css.
      const root = document.documentElement;
      const updateOverscroll = () => {
        const scrollable = root.scrollHeight - innerHeight;
        root.classList.toggle('near-end', scrollable > 0 && scrollY > scrollable / 2);
      };
      addEventListener('scroll', updateOverscroll, { passive: true });
      addEventListener('resize', updateOverscroll);
      updateOverscroll();

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-open');
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-fold]').forEach((el) => observer.observe(el));
    </script>

    <!-- Light up links under a finger on touch screens. -->
    <script>
      // Touch screens have no hover, so a link gets .is-touched while a finger rests on it,
      // including while that finger scrolls the page. Lifting after a scroll turns it off again;
      // lifting after a tap keeps it on until the linked page has loaded.
      // Passive listeners never delay scrolling.
      let touched: Element | null = null;
      let start = { x: 0, y: 0 };
      let scrolling = false;

      const release = () => {
        touched?.classList.remove('is-touched');
        touched = null;
      };

      addEventListener(
        'touchstart',
        (event) => {
          release();
          const { clientX, clientY } = event.touches[0];
          start = { x: clientX, y: clientY };
          scrolling = false;
          touched = (event.target as Element).closest('a');
          touched?.classList.add('is-touched');
        },
        { passive: true },
      );

      // Once a finger travels more than a few pixels it's scrolling, and the browser won't follow the link.
      addEventListener(
        'touchmove',
        (event) => {
          const { clientX, clientY } = event.touches[0];
          if (Math.hypot(clientX - start.x, clientY - start.y) > 10) scrolling = true;
        },
        { passive: true },
      );

      addEventListener('touchend', () => scrolling && release(), { passive: true });
      addEventListener('touchcancel', release, { passive: true });
      // Coming back from the linked page, the link may still be lit from the tap that left.
      addEventListener('pageshow', release);
    </script>
  </body>
</html>
